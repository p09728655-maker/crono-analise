# ---------------------------------------------------------------------------
# Variaveis de ambiente — configurar na Vercel em Settings > Environment Variables.
# NUNCA commitar o arquivo .env preenchido.
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Database > Connection string > Transaction pooler
# Precisa ser a porta 6543 (pooler), NAO a 5432 (conexao direta):
# funcao serverless abre e fecha conexao a cada request e estoura o limite do banco.
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Token de acesso a API. Gere um valor longo e aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# UUID da empresa criada na tabela `empresas`.
EMPRESA_ID=

# Chave da Anthropic — SOMENTE no servidor.
# Nao prefixar com VITE_: tudo que comeca com VITE_ vai para o bundle do
# navegador e ficaria publico.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Front-end (embutidas no bundle — tratar como publicas)
# ---------------------------------------------------------------------------
VITE_API_BASE=/api
VITE_API_TOKEN=
