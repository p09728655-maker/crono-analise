# ---------------------------------------------------------------------------
# Variaveis de ambiente — configurar na Vercel em Settings > Environment Variables.
# NUNCA commitar o arquivo .env preenchido.
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Database > Connection string > Transaction pooler
# Precisa ser a porta 6543 (pooler), NAO a 5432 (conexao direta):
# funcao serverless abre e fecha conexao a cada request e estoura o limite do banco.
DATABASE_URL=postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# NAO PREENCHA. Token de servico da transicao (pre-v2.34), mantido so'
# enquanto houve tablet com bundle antigo em cache. Preenche-lo hoje LIGA de
# volta o modo 'servico', onde exigirPapel() passa direto e as consultas
# rodam FORA da RLS — o que derruba, entre outras coisas, a garantia de que
# o tablet nao apaga estudo (api/_lib/auth.js e a politica estudos_apaga).
# Instalacao nova nasce sem ele; deixe vazio.
API_TOKEN=

# UUID da empresa criada na tabela `empresas`.
EMPRESA_ID=

# Chave da Anthropic — SOMENTE no servidor.
# Nao prefixar com VITE_: tudo que comeca com VITE_ vai para o bundle do
# navegador e ficaria publico.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Front-end (embutidas no bundle — tratar como publicas)
# ---------------------------------------------------------------------------
VITE_API_BASE=/api

# NAO PREENCHA — par do API_TOKEN acima. O bundle atual nem le' esta
# variavel; ela so' existe para nao quebrar deploy antigo.
VITE_API_TOKEN=

# ---------------------------------------------------------------------------
# OPCIONAIS — a URL do projeto Supabase e a chave publicavel ficam no codigo
# (src/lib/supabase.js, api/_lib/supabase.js): sao identificadores publicos
# por desenho. Defina estas quatro APENAS para apontar outro projeto (teste).
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=
